{
  "name": "lampa-adaptive-subtitles",
  "version": "1.1.0-beta.2",
  "private": true,
  "description": "Lampa plugin: dims subtitles for HDR / Dolby Vision / HLG video so they do not glare on OLED screens",
  "license": "MIT",
  "keywords": ["lampa", "lampa-plugin", "subtitles", "hdr", "dolby-vision", "webos", "smart-tv"],
  "scripts": {
    "build": "node build.js",
    "test": "node build.js && node tests/run_all.js",
    "check": "node tools/check-publish.js",
    "e2e:setup": "sh e2e/setup.sh",
    "e2e": "node e2e/run_all.js"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  },
  "engines": {
    "node": ">=18"
  }
}
